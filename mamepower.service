[Unit]
Description=MamePower Bot Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/mame/bot/mamepower
ExecStart=/bin/bash /home/mame/bot/mamepower/start.sh
EnvironmentFile=/home/mame/bot/mamepower/.env
Restart=always
RestartSec=10
User=mame

[Install]
WantedBy=multi-user.target